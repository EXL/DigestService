[Service]
Type=exec
User=exl
WorkingDirectory=/srv
ExecStart=/usr/bin/java -jar /srv/digest-service-current.jar
StandardOutput=journal
StandardError=journal
SyslogIdentifier=digest
SuccessExitStatus=143
Restart=always
RestartSec=10

# Security Hardening (Ubuntu Best Practices).
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
